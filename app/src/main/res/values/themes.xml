<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema terang dengan visual terinspirasi iOS, menggunakan komponen Material 3 -->
    <style name="Theme.FinTrack" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/brand_indigo</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">@color/brand_indigo</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>
        <item name="colorSecondary">@color/brand_indigo</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#EAF2FF</item>
        <item name="colorOnSecondaryContainer">@color/brand_indigo_dark</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface_variant</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorOutline">@color/text_tertiary</item>
        <item name="colorOutlineVariant">@color/outline</item>
        <item name="colorError">@color/expense_red</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:navigationBarDividerColor">@color/outline</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.FinTrack.Dialog</item>
    </style>

    <!-- Definisi tema dialog -->
    <style name="ThemeOverlay.FinTrack.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/brand_indigo</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
    </style>

    <!-- ========================================== -->
    <!-- Gaya Tipografi (Text Styles)               -->
    <!-- ========================================== -->
    <style name="Text.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Text.Overline" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- ========================================== -->
    <!-- Gaya Komponen (Widget Styles)              -->
    <!-- ========================================== -->
    <style name="Widget.FinTrack.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface_variant</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Widget.FinTrack.Fab" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/brand_indigo</item>
        <item name="tint">#FFFFFF</item>
    </style>

    <style name="Widget.FinTrack.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/surface_variant</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- PERBAIKAN: Menggunakan parent style dasar Android yang aman dan mengganti nama parameter ripple -->
    <style name="Widget.FinTrack.BottomNav" parent="android:Widget">
        <item name="backgroundTint">@color/surface</item>
        <item name="itemRippleColor">@color/brand_indigo_light</item>
    </style>
</resources>
